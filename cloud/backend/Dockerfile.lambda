# AWS Lambda container image for the cloud tier.
#
# BUILD FROM THE PROJECT ROOT so shared/ is inside the build context:
#   docker build -f cloud/backend/Dockerfile.lambda -t creditrag-backend:lambda .
#
# In CI this is built by .github/workflows/deploy.yml and pushed to ECR.
# See cloud/backend/Dockerfile for the uvicorn/EC2 variant of the same service.
#
# IMPORTANT: Lambda only accepts Docker v2 schema 2 manifests. If you build this
# by hand with buildx, pass --provenance=false --platform linux/amd64, or Lambda
# rejects the image with "The image manifest, config or layer media type for the
# source image is not supported."

# 3.12, NOT 3.11 — this is a hard requirement, not a version preference.
#
# Lambda's python:3.11 base image runs on Amazon Linux 2 (glibc 2.26); AL2023
# (glibc 2.34) only arrives with the python:3.12 runtime. numpy, faiss-cpu and
# tiktoken now publish x86_64 Linux wheels exclusively under manylinux_2_27 /
# manylinux_2_28 tags, which require glibc >= 2.27. On the 3.11 image not one
# of those wheels is installable, so pip silently falls back to source tarballs
# and the build dies in meson with "Unknown compiler(s)" — a Lambda base image
# has no C toolchain. Pinning older package versions only postpones this.
#
# The application itself is version-agnostic; nothing here is 3.11-specific.
FROM public.ecr.aws/lambda/python:3.12

# ---------------------------------------------------------------------------
# 0. Upgrade pip FIRST. Also load-bearing, not hygiene.
#
# The base image ships pip 24.0, which predates Metadata-Version 2.4 and treats
# wheels carrying it as incompatible — the same silent sdist fallback by a
# different route.
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# ---------------------------------------------------------------------------
# 1. CPU-only torch, installed BEFORE everything else.
#
# sentence-transformers depends on torch. If pip resolves it from PyPI it pulls
# the CUDA build (~2.5 GB of NVIDIA libraries that can never execute on Lambda).
# Installing from PyTorch's CPU index first means the dependency is already
# satisfied when sentence-transformers is installed below.
#
# --index-url gets us the +cpu local-version wheels, which sort HIGHER than the
# plain PyPI versions under PEP 440 and so win resolution; --extra-index-url
# keeps ordinary PyPI available for torch's transitive deps (sympy, networkx…).
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir torch \
        --index-url https://download.pytorch.org/whl/cpu \
        --extra-index-url https://pypi.org/simple

# ---------------------------------------------------------------------------
# 2. Application dependencies (no docling, no uvicorn — see the file header).
# ---------------------------------------------------------------------------
COPY cloud/backend/requirements-lambda.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# ---------------------------------------------------------------------------
# 3. Application code.
#
# shared/ sits next to app/ under LAMBDA_TASK_ROOT, which is already on
# sys.path, so `import shared` and `import app` both resolve with no path
# manipulation. (app/main.py also inserts a computed project root into
# sys.path; under Lambda that resolves to "/" and is harmless.)
# ---------------------------------------------------------------------------
COPY shared/            ${LAMBDA_TASK_ROOT}/shared/
COPY cloud/backend/app/ ${LAMBDA_TASK_ROOT}/app/

# ---------------------------------------------------------------------------
# 4. Bake the transformer models into the image.
#
# The cross-encoder (~90 MB) and MiniLM embedder (~80 MB) are loaded eagerly by
# retrieval.py and lazily by doc_search.py. Downloading them at runtime would
# add tens of seconds to every cold start and fail outright if the VPC has no
# egress — so they ship in the image.
# ---------------------------------------------------------------------------
ENV HF_HOME=/opt/hf-cache \
    SENTENCE_TRANSFORMERS_HOME=/opt/hf-cache

RUN python -c "from sentence_transformers import CrossEncoder, SentenceTransformer; \
    CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2'); \
    SentenceTransformer('all-MiniLM-L6-v2')"

# Set only AFTER the download above, or it would have nothing to download.
# At runtime the Lambda filesystem is read-only outside /tmp; without these,
# huggingface_hub attempts a revision check and a lock-file write on every cold
# start, which is both slow and a source of spurious errors.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Trim bytecode caches left by the model download step (~50-80 MB).
# Globbed so it survives a future base-image version bump.
RUN find /var/lang/lib/python3.*/site-packages -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true

# Mangum adapter exposed at app/main.py:49
CMD ["app.main.handler"]
